{
  "name": "@hyperse/translator",
  "version": "1.4.0",
  "description": "Translates messages from the given namespace by using the ICU syntax.",
  "keywords": [
    "hyperse",
    "ICU",
    "translator"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/translator.git"
  },
  "main": "./dist/index.mjs",
  "files": [
    "./bin/",
    "./dist/",
    "./index.js"
  ],
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "cz": "cz",
    "lint": "eslint .",
    "lint-staged-files": "lint-staged --allow-empty",
    "prepare": "husky",
    "release": "yarn build && changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "resolutions": {
    "typescript": "^6.x"
  },
  "dependencies": {
    "@formatjs/fast-memoize": "^3.1.7",
    "intl-messageformat": "^12.1.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@hyperse/ts-node-paths": "^1.0.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
